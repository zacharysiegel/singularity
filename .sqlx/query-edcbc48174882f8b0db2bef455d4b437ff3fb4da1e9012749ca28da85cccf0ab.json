{
  "db_name": "PostgreSQL",
  "query": "select s.id, s.account_id, s.token, s.created, s.expires\n         from session s\n         inner join account a on a.id = s.account_id\n         where s.token = $1\n           and s.expires > now()\n           and a.deleted_at is null",
