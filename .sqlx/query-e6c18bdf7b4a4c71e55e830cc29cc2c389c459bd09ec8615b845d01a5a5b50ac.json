{
  "db_name": "PostgreSQL",
  "query": "with membership_counts as ( select game_membership.game_id, count(*) as member_count from game_membership group by game_membership.game_id ) select g.id, g.name, g.creator_id, g.status, g.max_players, coalesce(membership_counts.member_count, 0) as \"member_count!\", g.created from game g left join membership_counts on membership_counts.game_id = g.id where ($1::int is null or g.status = $1) order by g.created desc",
