{
  "db_name": "PostgreSQL",
  "query": "select g.id, g.name, g.creator_id, g.status, g.max_players,\n                mcv.member_count as \"member_count!\",\n                g.created\n         from game g\n         inner join game_member_count_view mcv on mcv.game_id = g.id\n         where ($1::int is null or g.status = $1)\n         order by g.status asc, g.created desc",
