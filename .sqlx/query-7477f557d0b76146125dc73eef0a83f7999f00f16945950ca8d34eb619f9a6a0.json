  "query": "select g.id, g.name, g.creator_id, g.status, g.max_players, coalesce(mcv.member_count, 0) as \"member_count!\", g.created from game g left join game_member_count_view mcv on mcv.game_id = g.id where ($1::int is null or g.status = $1) order by g.created desc",
